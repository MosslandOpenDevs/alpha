# Alpha by Mossland — environment template
# Copy to `.env.local` and fill in.

# ─── Server ──────────────────────────────────────────────────────────
# Port (production default: 6900)
PORT=6900

# Public base URL — used for canonical, OG, JSON-LD
NEXT_PUBLIC_BASE_URL=https://alpha.moss.land

# Number of trusted reverse proxies in front of the app. The client IP for
# rate limiting is taken this many hops from the right of X-Forwarded-For
# (the left end is caller-spoofable). 0 = nearest proxy's peer (default);
# set 1 when behind a CDN → reverse proxy, etc.
# TRUSTED_PROXY_HOPS=0

# ─── Storage ─────────────────────────────────────────────────────────
# SQLite file. Defaults to ./data/alpha-dev.sqlite if unset.
# DB_PATH=/var/lib/alpha/alpha.sqlite

# Directory holding canonical-{entities,topics,events}.json + yt-*.json
# from a SignalMap pipeline run. Defaults to ./mic-data if unset.
# MIC_DATA_PATH=/var/lib/alpha/mic-data

# (optional) Path to a checked-out SignalMap repo. Only used to read
# seed/channels.json for /creator/* pages. Defaults to ../signalmap.
# SIGNALMAP_ROOT=/var/lib/signalmap

# ─── AI ──────────────────────────────────────────────────────────────
# xAI Grok — answers / synthesis / personas
# GROK_API_KEY=
# GROK_MODEL=grok-4-1-fast-non-reasoning

# OpenAI — embeddings + audit web search
# OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ─── Macro feeds (free tiers) ────────────────────────────────────────
# Bank of Korea (ECOS) — https://ecos.bok.or.kr
# ECOS_API_KEY=

# St. Louis Fed (FRED) — https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# CoinGecko — free tier works without a key
# COINGECKO_API_KEY=

# ─── IndexNow (Bing / Naver / Brave / Yandex instant indexing) ──────
# Generate any 32-128 char hex key, also serve at /<KEY>.txt
# INDEXNOW_KEY=
# Bearer token required to call POST/GET /api/admin/indexnow. If unset, the
# admin endpoint is disabled (fail-closed). The weekly cron pings directly.
# INDEXNOW_ADMIN_TOKEN=
# Where the weekly cron stores its "last pinged" watermark. Defaults to
# indexnow-cron-state.json next to DB_PATH so it survives release swaps.
# Use an ABSOLUTE path — a relative one resolves against the release dir.
# INDEXNOW_STATE_FILE=/abs/path/indexnow-cron-state.json

# Where the weekly LLM citation audit writes its results. Defaults to
# audit-results/ next to DB_PATH, for the same reason as above: pm2 runs the
# cron with cwd set to the release directory, so a relative path throws away
# every paid run on the next deployment.
# AUDIT_RESULTS_DIR=/abs/path/audit-results

# Webhook (Discord/Slack) for operational alerts. scripts/health-alert.ts posts
# here when /api/health changes into or out of a failing state, plus one daily
# summary — the summary doubles as proof the watchdog itself is still running.
# scripts/deploy.sh reads the same value for deploy failures. This is a
# credential: keep it in .env.local, never in a committed file.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# HEALTH_ALERT_SUMMARY_HOUR=10

# ─── DB 백업 (scripts/backup-db.ts, 매일 03:00 KST) ──────────────────
# 스냅샷 위치. 기본값은 deploy.sh 의 배포 전 백업과 같은 ~/backups/alpha.
# BACKUP_DIR=/abs/path/backups
# 보관 개수 (기본 14). 매 실행이 DB 전체 사본 한 개를 추가한다.
# BACKUP_KEEP=14
# ★ 호스트 밖으로 미는 rsync 목적지. 이게 비어 있으면 원본과 사본이 같은
#   디스크에 있고, 호스트가 사라지면 둘 다 사라진다 — 백업이 아니라 실행
#   취소다. 설정해 두면 복사 실패가 /health 의 db_backup 을 빨갛게 만든다.
# BACKUP_REMOTE=user@backup-host:/srv/alpha-backups/
# BACKUP_RSYNC_BIN=rsync

# ─── (Optional) OAuth for community accounts ─────────────────────────
# SESSION_SECRET=
# KAKAO_OAUTH_CLIENT_ID=
# KAKAO_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
